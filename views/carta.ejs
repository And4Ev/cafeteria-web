<%- include('partials/header') %>
<link rel="stylesheet" href="/css/pages/carta.css">
</header>
<body>

  <!-- ------------------- HERO CARTA ------------------- -->
  <div class="carta-band"></div>
  <section class="carta-hero">
    <div class="carta-hero-inner">
      <div class="carta-hero-label">— Lo que servimos -</div>
      <h1 class="carta-hero-title">Nuestra<br><em>carta.</em></h1>
      <p class="carta-hero-sub">
        Café de especialidad · Bollería · Bagels 
      </p>
      <div class="carta-hero-meta">
        <span>Lun – Vie &nbsp;7:30–20:00</span>
        <span class="carta-hero-sep">·</span>
        <span>Sáb – Dom &nbsp;9:00–21:00</span>
      </div>
    </div>
    <div class="carta-hero-deco" aria-hidden="true">carta</div>
  </section>

  <!-- ------------------- FILTROS ------------------- -->
  <section class="carta-filters-bar">
    <div class="carta-filters-inner">
      <span class="carta-filters-label">Filtrar por</span>
      <div class="carta-filter-btns">
        <!--<button class="carta-filter-btn active" data-filter="all">Todo</button> -->
        <button class="carta-filter-btn active" data-filter="café">Cafés</button>
        <button class="carta-filter-btn" data-filter="invierno">Invierno</button>
        <button class="carta-filter-btn" data-filter="verano">Verano</button>
        <button class="carta-filter-btn" data-filter="desayuno">Desayunos</button>
        <button class="carta-filter-btn" data-filter="merienda">Meriendas</button>
        <button class="carta-filter-btn" data-filter="bagel">Bagels</button>
        <button class="carta-filter-btn" data-filter="bollería">Bollería</button>
        
      </div>
    </div>
  </section>

  <!-- ------------------- GRID PRODUCTOS ------------------- -->
  <section class="carta-menu-section">
    <div class="carta-menu-grid" id="cartaMenuGrid">
      <% productosDB.forEach(item => { %>
        <div class="menu-card" data-cat="<%= item.nombre_categoria.toLowerCase() %>">
          <div class="menu-card-cat"><%= item.nombre_categoria %></div>
          <div class="menu-card-name"><%= item.nombre %></div>
          <div class="menu-card-desc"><%= item.descripcion %></div>
          <% if (usuarioLogueado) { %>
            <div class="menu-card-price crossed"><%= item.precio %>€</div>
            <!-- Solo por ser insider tienes un 0.02% de descuento -->
            <!-- con la primera compra como insider se aplica el 0.02 por ciento y pasas a 
              tener X puntos la barrita se mueve a nuevo insider -->
            <div class="menu-card-price"><%= (item.precio * 0.98).toFixed(2) %>€</div>
            <% } else { %>
              <div class="menu-card-price"><%= item.precio %>€</div>
              <% } %>
        </div>
      <% }) %>
    </div>
    <div class="carta-empty-state" id="cartaEmpty" style="display:none;">
      <span>No hay productos en esta categoría por el momento.</span>
    </div>
  </section>

  <!-- ------------------- COMBOS EXPANDIDOS ------------------- -->
  <section class="carta-combos-section">
    <div class="carta-combos-header reveal">
      <div class="section-label" style="color:var(--caramel)">Ofertas especiales</div>
      <h2 class="carta-combos-title">Combos para<br>cada <em>momento.</em></h2>
      <p class="carta-combos-sub">Pensados para sacarle el máximo partido a tu visita, sea cual sea la hora.</p>
    </div>

    <div class="carta-combos-grid">

      <!-- COMBO 1 -->
      <div class="carta-combo-card reveal">
        <div class="carta-combo-num">01</div>
        <div class="carta-combo-header">
          <div class="carta-combo-time">7:00 – 11:00</div>
          <div class="carta-combo-name">Buenos días</div>
        </div>
        <ul class="carta-combo-list">
          <li>Café solo o con leche (tamaño mediano)</li>
          <li>Bagel de tu elección</li>
        </ul>
        <div class="carta-combo-footer">
          <span class="carta-combo-price">7,90€</span>
          <span class="carta-combo-tag">Desayuno</span>
        </div>
      </div>

      <!-- COMBO 2 -->
      <div class="carta-combo-card reveal reveal-delay-1">
        <div class="carta-combo-num">02</div>
        <div class="carta-combo-header">
          <div class="carta-combo-time">16:00 – 19:00</div>
          <div class="carta-combo-name">La hora del estudio</div>
        </div>
        <ul class="carta-combo-list">
          <li>Café de especialidad</li>
          <li>Pieza de bollería a elegir</li>
        </ul>
        <div class="carta-combo-footer">
          <span class="carta-combo-price">5,50€</span>
          <span class="carta-combo-tag">Tarde</span>
        </div>
      </div>

      <!-- COMBO 3 — nuevo -->
      <div class="carta-combo-card reveal reveal-delay-2">
        <div class="carta-combo-num">03</div>
        <div class="carta-combo-header">
          <div class="carta-combo-time">Todo el día</div>
          <div class="carta-combo-name">Para dos</div>
        </div>
        <ul class="carta-combo-list">
          <li>2 cafés de especialidad a elegir</li>
          <li>2 piezas de bollería o Bagel clásico</li>
        </ul>
        <div class="carta-combo-footer">
          <span class="carta-combo-price">14,90€</span>
          <span class="carta-combo-tag">Pareja</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------- CTA FINAL ------------------- -->
  <section class="carta-cta-section">
    <div class="carta-cta-inner reveal">
      <div class="carta-cta-label">¿Algo más?</div>
      <h2 class="carta-cta-title">¿No ves lo<br>que buscas?</h2>
      <p class="carta-cta-text">
        Cuéntanos qué necesitas. Adaptamos los combos para grupos, eventos o necesidades especiales. Estamos aquí.
      </p>
      <div class="carta-cta-btns">
        <a href="contacto" class="btn-primary">Escríbenos</a>
        <a href="salas" class="btn-ghost">Ver las salas</a>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>

