<!-- HEADER -->
<%- include('partials/header') %>
<body>
<!-- COMBOS -->
<div class="combos-band">
    <div class="combo-intro reveal">
        <h2>Combos<br>para tu<br><em style="font-style:italic;color:var(--roast)">momento.</em></h2>
        <p>Diseñados para que tu hora favorita sea aún mejor.</p>
    </div>
    <div class="combo-card reveal reveal-delay-1">
        <div class="combo-time">7:00 – 11:00</div>
        <div class="combo-name">Buenos días</div>
        <div class="combo-items">Café solo o con leche + bagel de tu elección + zumo natural.<br>El desayuno que te
            mereces.</div>
    </div>
    <div class="combo-card reveal reveal-delay-2">
        <div class="combo-time">16:00 – 19:00</div>
        <div class="combo-name">La hora del estudio</div>
        <div class="combo-items">Café mediano + pieza de bollería + acceso a sala durante 2h.<br>Para los que van a
            lo que van.</div>
    </div>
</div>

 <!-- MENU -->
 <section id="menu">
    <div class="section-header reveal">
        <div>
            <div class="section-label">02 — Lo que servimos</div>
            <h2 class="section-title">La <em>carta</em></h2>
        </div>
        <div class="season-toggle">
            <button class="season-btn active" onclick="setSeason('winter', this)">☕ Invierno</button>
            <button class="season-btn" onclick="setSeason('summer', this)">🧊 Verano</button>
        </div>
    </div>

    <div class="menu-grid" id="menuGrid">
        <!-- filled by JS -->
    </div>
</section>

<!-- FOOTER -->
<%- include('partials/footer') %>