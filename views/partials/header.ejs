<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>La hora del Café</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Outfit:wght@300;400;500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/layout.css">

    <script src="/js/main.js" defer></script>
        <% if (typeof extraScripts !== 'undefined') { %>
            <% extraScripts.forEach(script => { %>
                <script src="/js/<%= script %>.js" defer></script>
            <% }) %>
        <% } %>

</head>

<header>
    <!-- CURSOR — granito de café -->
    <svg class="cursor" id="cursor" viewBox="0 0 22 14" xmlns="http://www.w3.org/2000/svg">
        <!-- cuerpo del grano -->
        <ellipse cx="11" cy="7" rx="10" ry="6.2" fill="#2c1a0e" />
        <!-- línea central del grano (surco) -->
        <path d="M11 1.8 C7 3.5 7 10.5 11 12.2" stroke="#c8864a" stroke-width="1.1" fill="none"
            stroke-linecap="round" />
    </svg>
    <!-- NAV -->
    <nav>
        <a href="/" class="nav-logo"><img src="/images/dibujo-taza-cafe.png" alt=""><span></span></a>
        <ul class="nav-links" id="navLinks">
            <li><a href="/">Home</a></li>
            <li><a href="carta">Carta</a></li>
            <li><a href="salas">Salas</a></li>
            <li><a href="contacto">Contacto</a></li>
            <li>
                <% if (usuarioLogueado) { %>
                    <a href="/perfil" class="nav-btn">Mi Cuenta</a>
                
                <% } else { %>
                    <a href="login" class="nav-btn">Acceder</a>
                    <% } %>
            </li>
        </ul>
    
    <button class="nav-hamburger" id="navToggle" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-mobile-overlay" id="navOverlay"></div>

    </nav>