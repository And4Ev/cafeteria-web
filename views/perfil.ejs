<%- include('partials/header') %>
<link rel="stylesheet" href="/css/pages/perfil.css">
</header>
<body>

  <!-- ------------------- HERO PERFIL ------------------- -->
  <section class="perfil-hero">
    <div class="perfil-hero-inner">
      <div class="perfil-hero-label">Mi cuenta</div>
      <h1 class="perfil-hero-title">
        Hola,<br><em><%= usuario.username %>.</em>
      </h1>
      <p class="perfil-hero-sub">
        Insider desde <%= new Date(usuario.fecha_registro).toLocaleDateString('es-ES', { day:'numeric', month:'long', year:'numeric' }) %>
      </p>
    </div>
    <div class="perfil-hero-deco" aria-hidden="true">insider</div>
    <form action="/logout" method="POST" class="perfil-logout-form">
      <button type="submit" class="perfil-logout-btn">Cerrar sesión</button>
    </form>
  </section>

  <!-- ------------------- GRID PRINCIPAL ------------------- -->
  <section class="perfil-grid">

    <!-- TARJETA PUNTOS -->
    <div class="perfil-card-puntos reveal">
      <div class="pcard-rings">
        <div class="pcard-ring"></div>
        <div class="pcard-ring"></div>
      </div>
      <div class="pcard-chip"></div>
      <div class="pcard-points-label">Puntos acumulados</div>
      <div class="pcard-points"><%= usuario.puntos || 0 %> <span>pts</span></div>
      <div class="pcard-divider"></div>
      <div class="pcard-bottom">
        <div>
          <div class="pcard-field-label">Usuario</div>
          <div class="pcard-field-value"><%= usuario.username %></div>
        </div>
        <div>
          <div class="pcard-field-label">Estado</div>
          <div class="pcard-field-value pcard-status">
            <span class="pcard-dot"></span> Insider
          </div>
        </div>
        <div class="pcard-logo">
          <img src="/images/dibujo-taza-cafe.png" alt="logo">
        </div>
      </div>
    </div>

    <!-- DATOS PERSONALES -->
    <div class="perfil-datos reveal reveal-delay-1">
      <div class="perfil-block-label">Datos personales</div>
      <div class="perfil-datos-grid">
        <div class="perfil-dato">
          <div class="perfil-dato-label">Nombre completo</div>
          <div class="perfil-dato-value"><%= usuario.nombre %></div>
        </div>
        <div class="perfil-dato">
          <div class="perfil-dato-label">Usuario</div>
          <div class="perfil-dato-value">@<%= usuario.username %></div>
        </div>
        <div class="perfil-dato">
          <div class="perfil-dato-label">Email</div>
          <div class="perfil-dato-value"><%= usuario.email %></div>
        </div>
        <div class="perfil-dato">
          <div class="perfil-dato-label">Miembro desde</div>
          <div class="perfil-dato-value">
            <%= new Date(usuario.fecha_registro).toLocaleDateString('es-ES', { day:'numeric', month:'long', year:'numeric' }) %>
          </div>
        </div>
        <div class="perfil-dato">
          <div class="perfil-dato-label">Tipo de cuenta</div>
          <div class="perfil-dato-value perfil-dato-badge">Insider — Nuevo</div>
        </div>
        <div class="perfil-dato">
          <div class="perfil-dato-label">Puntos acumulados</div>
          <div class="perfil-dato-value"><%= usuario.puntos || 0 %> pts</div>
        </div>
      </div>
    </div>

    <!-- MIS RESERVAS -->
<div class="perfil-reservas reveal reveal-delay-1">
  <div class="perfil-block-label">Mis reservas de salas</div>

  <% if (reservas && reservas.length > 0) { %>

    <div class="res-list">
      <% reservas.forEach((res, i) => { %>

        <%
          /* ── Formateo de fecha ── */
          const fechaObj  = new Date(res.fecha);
          const diaNom    = fechaObj.toLocaleDateString('es-ES', { weekday: 'short' });
          const diaN      = fechaObj.toLocaleDateString('es-ES', { day: '2-digit' });
          const mesNom    = fechaObj.toLocaleDateString('es-ES', { month: 'short' });

          /* ── Estado → clase CSS ── */
          const estadoMap = {
            pendiente:  { cls: 'res-badge--pending',   txt: 'Pendiente' },
            confirmada: { cls: 'res-badge--confirmed',  txt: 'Confirmada' },
            cancelada:  { cls: 'res-badge--cancelled',  txt: 'Cancelada' },
          };
          const badge = estadoMap[res.estado] || { cls: 'res-badge--pending', txt: res.estado };
        %>

        <div class="res-card">

          <!-- Fecha compacta -->
          <div class="res-date">
            <span class="res-date-day-name"><%= diaNom %></span>
            <span class="res-date-day-num"><%= diaN %></span>
            <span class="res-date-month"><%= mesNom %></span>
          </div>

          <!-- Separador vertical -->
          <div class="res-divider"></div>

          <!-- Info principal -->
          <div class="res-info">
            <div class="res-sala"><%= res.nombre_sala %></div>
            <div class="res-meta">
              <span class="res-meta-item">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <%= res.hora.substring(0,5) %>
              </span>
              <span class="res-meta-sep">·</span>
              <span class="res-meta-item">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <%= res.duracion %>h de duración
              </span>
            </div>
          </div>

          <!-- Badge estado -->
          <div class="res-badge <%= badge.cls %>"><%= badge.txt %></div>

        </div>

      <% }) %>
    </div>

  <% } else { %>

    <!-- Estado vacío -->
    <div class="res-empty">
      <div class="res-empty-icon">🗓</div>
      <div class="res-empty-title">Sin reservas activas</div>
      <div class="res-empty-text">Aún no has reservado ninguna sala.</div>
      <a href="/salas" class="res-empty-cta">Ver salas disponibles</a>
    </div>

  <% } %>
</div>

    <!-- VENTAJAS -->
    <div class="perfil-ventajas reveal reveal-delay-2">
      <div class="perfil-block-label">Tus ventajas Insider</div>
      <div class="perfil-ventajas-list">

        <div class="perfil-ventaja perfil-ventaja--active">
          <div class="perfil-ventaja-icon">🗓</div>
          <div class="perfil-ventaja-info">
            <div class="perfil-ventaja-title">Reserva de salas</div>
            <div class="perfil-ventaja-desc">Acceso a reservar salas privadas.</div>
          </div>
          <div class="perfil-ventaja-badge">Activo</div>
        </div>

        <div class="perfil-ventaja perfil-ventaja--locked">
          <div class="perfil-ventaja-icon">🏷</div>
          <div class="perfil-ventaja-info">
            <div class="perfil-ventaja-title">Ofertas Insider exclusivas</div>
            <div class="perfil-ventaja-desc">Descuentos y combos que no aparecen en carta. Desde 500 puntos.</div>
          </div>
          <div class="perfil-ventaja-badge perfil-ventaja-badge--locked">500 pts</div>
        </div>

        <div class="perfil-ventaja perfil-ventaja--locked">
          <div class="perfil-ventaja-icon">🎁</div>
          <div class="perfil-ventaja-info">
            <div class="perfil-ventaja-title">Café de bienvenida gratis</div>
            <div class="perfil-ventaja-desc">Un café gratis cada vez que visites. Desde 1.000 puntos.</div>
          </div>
          <div class="perfil-ventaja-badge perfil-ventaja-badge--locked">1.000 pts</div>
        </div>

      </div>
    </div>
  </section>

<%- include('partials/footer') %>