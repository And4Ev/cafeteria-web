<%- include('partials/header') %>
<link rel="stylesheet" href="/css/pages/recuperar.css">
</header>
<body>

  <!-- ------------------- HERO RECUPERAR ------------------- -->
  <section class="login-page">

    <div class="login-left">
      <div class="login-brand-label">Área privada</div>
      <h1 class="login-brand-title">Recupera<br><em>tu acceso.</em></h1>
      <p class="login-brand-text">Introduce tu email de socio y establece una nueva contraseña para volver a disfrutar de todos los beneficios del programa Insider.</p>
      <div class="login-perks">
        <div class="login-perk">
          <span class="login-perk-icon">☕</span>
          <span>Tus puntos siguen ahí</span>
        </div>
        <div class="login-perk">
          <span class="login-perk-icon">🗓</span>
          <span>Reservas y beneficios intactos</span>
        </div>
        <div class="login-perk">
          <span class="login-perk-icon">🏷</span>
          <span>Ofertas exclusivas Insider</span>
        </div>
      </div>
      <div class="login-deco" aria-hidden="true">insider</div>
    </div>

    <div class="login-right">

      <!-- ------------------- PANEL RECUPERAR ------------------- -->
      <div class="login-panel" id="panelRecuperar" style="display: <%= (typeof exito !== 'undefined' && exito) ? 'none' : 'block' %>;">
        <div class="login-panel-label">Recuperación de cuenta</div>
        <h2 class="login-panel-title">Nueva contraseña</h2>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="login-alert login-alert--error"><%= error %></div>
        <% } %>

        <form class="login-form" action="/recuperar" method="POST" id="formRecuperar">
          <div class="lf-field">
            <label class="lf-label">Email de socio</label>
            <input type="email" class="lf-input" name="email" placeholder="tu@email.com" required autocomplete="email">
          </div>
          <div class="lf-field">
            <label class="lf-label">Nueva contraseña</label>
            <div class="lf-input-wrap">
              <input type="password" class="lf-input" name="password" placeholder="Mínimo 8 caracteres" required minlength="8" id="recPass" autocomplete="new-password">
              <button type="button" class="lf-eye" id="eyeRec1" aria-label="Mostrar contraseña">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <div class="lf-strength" id="passStrength">
              <div class="lf-strength-bar" id="strengthBar"></div>
            </div>
            <span class="lf-hint" id="hintPass"></span>
          </div>
          <div class="lf-field">
            <label class="lf-label">Repetir nueva contraseña</label>
            <div class="lf-input-wrap">
              <input type="password" class="lf-input" name="password2" placeholder="Repite tu contraseña" required minlength="8" id="recPass2" autocomplete="new-password">
              <button type="button" class="lf-eye" id="eyeRec2" aria-label="Mostrar contraseña">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <span class="lf-hint lf-hint--error" id="hintPass2"></span>
          </div>
          <button type="submit" class="btn-primary lf-submit" id="btnActualizar">Actualizar contraseña</button>
        </form>

        <div class="login-switch">
          ¿Recuerdas tu contraseña?
          <a href="/login" class="login-switch-btn">Volver a login</a>
        </div>
    </div>

      <!-- ------------------- PANEL ÉXITO ------------------- -->
      <div class="login-panel" id="panelExito" style="display: <%= (typeof exito !== 'undefined' && exito) ? 'block' : 'none' %>;">
        <div class="login-panel-label">Todo listo</div>
        <h2 class="login-panel-title">Contraseña<br><em>actualizada.</em></h2>

        <div class="login-alert login-alert--success rec-success-msg">
          ✓ &nbsp; Contraseña actualizada con éxito
        </div>

        <p class="rec-exito-text">Ya puedes acceder a tu cuenta Insider con tu nueva contraseña.</p>

        <a href="/login" class="btn-primary lf-submit rec-btn-login">Ir a iniciar sesión</a>
      </div>

    </div>
  </section>

<%- include('partials/footer') %>